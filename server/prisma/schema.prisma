// MiniEdCRM database schema
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Users & roles ───────────────────────────────

enum Role {
  ADMIN
  MENTOR
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  phone        String?
  isActive     Boolean  @default(true)
  // Sign-in tokens carry this number. Changing or resetting the password
  // bumps it, which signs out every existing session at once.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Students belong to one batch. Null for admins and mentors.
  batchId String?
  batch   Batch?  @relation("BatchStudents", fields: [batchId], references: [id], onDelete: SetNull)

  // The lead this student was converted from, if any.
  convertedFromLead Lead? @relation("LeadConversion")

  mentoredBatches  Batch[]              @relation("BatchMentor")
  leadsCreated     Lead[]               @relation("LeadCreator")
  leadsAssigned    Lead[]               @relation("LeadAssignee")
  leadNotes        LeadNote[]
  leadActivities   LeadActivity[]
  attendance       Attendance[]         @relation("AttendanceStudent")
  attendanceMarked Attendance[]         @relation("AttendanceMarker")
  quizzesCreated   Quiz[]
  quizAttempts     QuizAttempt[]
  practiceRuns     PracticeRun[]
  tasksCreated     Task[]               @relation("TaskCreator")
  taskSubmissions  TaskSubmission[]     @relation("TaskSubmitter")
  taskReviews      TaskSubmission[]     @relation("TaskReviewer")
  documents        Document[]
  passwordResets   PasswordResetToken[]
  paymentsCreated  Payment[]            @relation("PaymentCreator")

  @@index([role])
  @@index([batchId])
}

// One-time links for "forgot password". Only a SHA-256 hash of the token is
// stored, so a database leak can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────── Leads pipeline ──────────────────────────────

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  ENROLLED
  LOST
}

model Lead {
  id             String    @id @default(cuid())
  name           String
  email          String
  phone          String?
  source         String? // e.g. "Website", "Referral", "CSV import"
  courseInterest String?
  stage          LeadStage @default(NEW)
  nextFollowUpAt DateTime? // drives the daily follow-up reminder email
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdById  String
  createdBy    User    @relation("LeadCreator", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Set when the lead is marked ENROLLED and a student account is created.
  convertedUserId String? @unique
  convertedUser   User?   @relation("LeadConversion", fields: [convertedUserId], references: [id], onDelete: SetNull)

  notes      LeadNote[]
  activities LeadActivity[]
  payments   Payment[]

  // Indexes match the list page: filter by stage, sort by newest, search by email,
  // and the reminder job's "follow-ups due today" query.
  @@index([stage, createdAt])
  @@index([email])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([leadId, createdAt])
}

enum ActivityType {
  CREATED
  IMPORTED
  STAGE_CHANGED
  NOTE_ADDED
  ASSIGNED
  CONVERTED
  REMINDER_SENT
  PAYMENT_RECEIVED
}

// Append-only log that powers the lead's activity timeline.
model LeadActivity {
  id        String       @id @default(cuid())
  type      ActivityType
  meta      Json? // e.g. { "from": "NEW", "to": "CONTACTED" }
  createdAt DateTime     @default(now())

  leadId  String
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId String? // null when the system did it (e.g. a scheduled job)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// ─────────────────────────────── Batches & attendance ────────────────────────

model Batch {
  id           String    @id @default(cuid())
  name         String    @unique // e.g. "FS-Web-Jan-2027"
  course       String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  // Course fee in paise (₹1 = 100 paise), as an integer so money never has rounding errors.
  // Null = no fee, so enrolling doesn't ask for a payment.
  feePaise     Int?
  // How long one class day is, in minutes. Turns attended days into learning time.
  // Null = not set, so the time-spent page shows days rather than guessing hours.
  classMinutes Int?
  // Students who sign up themselves can join with this code. Null = joining by code is off.
  joinCode     String?   @unique
  createdAt    DateTime  @default(now())

  mentorId String?
  mentor   User?   @relation("BatchMentor", fields: [mentorId], references: [id], onDelete: SetNull)

  students   User[]       @relation("BatchStudents")
  attendance Attendance[]
  quizzes    Quiz[]
  payments   Payment[]
  tasks      Task[]

  @@index([mentorId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())

  batchId    String
  batch      Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId  String
  student    User   @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  markedById String
  markedBy   User   @relation("AttendanceMarker", fields: [markedById], references: [id])

  // One record per student per day. Re-marking updates it instead of duplicating.
  @@unique([studentId, date])
  @@index([batchId, date])
}

// ─────────────────────────────── Quizzes ─────────────────────────────────────

model Quiz {
  id              String   @id @default(cuid())
  title           String
  description     String?
  durationSeconds Int // time limit, enforced on the server at submit
  isPublished     Boolean  @default(false)
  // TEST: one timed, ranked attempt. PRACTICE: retake as often as you like, with the
  // answers and explanations straight after; never ranked.
  mode            QuizMode @default(TEST)
  // Share of a question's points taken off for a wrong answer (0 = no negative marking).
  // A skipped question never costs anything, so guessing can't inflate a score.
  negativePercent Int      @default(0)
  // Pass mark as a percentage of the maximum score. Null = no pass/fail.
  passPercent     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  batchId     String
  batch       Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  questions    Question[]
  attempts     QuizAttempt[]
  practiceRuns PracticeRun[]

  @@index([batchId, isPublished])
}

enum QuizMode {
  TEST
  PRACTICE
}

model Question {
  id       String @id @default(cuid())
  text     String
  points      Int     @default(1)
  position    Int // display order within the quiz
  // The skill this question checks (e.g. "SQL joins"). Drives the skill-gap report.
  skill       String?
  // Shown with the answer after submitting: why the right option is right.
  explanation String?

  quizId  String
  quiz    Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
  answers AttemptAnswer[]

  @@index([quizId, position])
}

model Option {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false) // never sent to students before submission
  position  Int     @default(0) // display order within the question

  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@index([questionId, position])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model QuizAttempt {
  id          String        @id @default(cuid())
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  // A Float because negative marking takes off fractions of a point. Never below 0.
  score       Float         @default(0)
  maxScore    Int           @default(0)
  timeTakenMs Int? // tie-breaker on the leaderboard

  quizId    String
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  answers AttemptAnswer[]

  // One attempt per student per quiz.
  @@unique([quizId, studentId])
  // Leaderboard query: submitted attempts for a quiz, best score first.
  @@index([quizId, status, score(sort: Desc)])
}

model AttemptAnswer {
  id        String  @id @default(cuid())
  isCorrect Boolean

  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String? // null if the student skipped the question
  option     Option?     @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
}

// One go at a practice quiz. Practice can be repeated, so it's kept apart from
// QuizAttempt (one per student per quiz) and never reaches a leaderboard.
model PracticeRun {
  id          String   @id @default(cuid())
  score       Float
  maxScore    Int
  correct     Int
  wrong       Int
  skipped     Int
  timeTakenMs Int?
  createdAt   DateTime @default(now())

  quizId    String
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([quizId, studentId])
}

// ─────────────────────────────── Tasks ───────────────────────────────────────

// Work a mentor sets a batch: an assignment, a mini project, a reading.
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime?
  maxPoints   Int? // null = not graded, just reviewed
  createdAt   DateTime  @default(now())

  batchId     String
  batch       Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  submissions TaskSubmission[]

  @@index([batchId, dueAt])
}

enum SubmissionStatus {
  SUBMITTED // waiting for the mentor
  CHANGES_REQUESTED // the mentor sent it back; the student can resubmit
  ACCEPTED // done
}

// A student's work on a task: a link (GitHub, Drive…) and/or a note. One per student per task;
// resubmitting replaces it.
model TaskSubmission {
  id          String           @id @default(cuid())
  link        String?
  note        String?
  status      SubmissionStatus @default(SUBMITTED)
  points      Int?
  feedback    String?
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  taskId       String
  task         Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId    String
  student      User    @relation("TaskSubmitter", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?   @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([taskId, studentId])
  @@index([studentId])
}

// ─────────────────────────────── Files ───────────────────────────────────────

enum DocumentKind {
  RESUME
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  kind         DocumentKind @default(RESUME)
  originalName String
  storedName   String       @unique // random id (and file name on disk with FILE_STORAGE=disk), never the user's name
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime     @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // The file itself when FILE_STORAGE=database (the default). Kept in its own
  // table so listing documents never loads file contents.
  blob DocumentBlob?

  @@index([ownerId, kind])
}

model DocumentBlob {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  data       Bytes
}

// ─────────────────────────────── Email log ───────────────────────────────────

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

// One row per queued email, so admins can see what was sent and what failed
// after all retries.
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  template  String // "welcome" | "quiz-result" | "lead-follow-up"
  status    EmailStatus @default(QUEUED)
  attempts  Int         @default(0)
  lastError String?
  jobId     String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

// ─────────────────────────────── Payments ────────────────────────────────────

enum PaymentStatus {
  CREATED // order made at the gateway, waiting for the payer
  PAID // the gateway confirmed it (signed checkout result or webhook)
  FAILED // the payer's attempt failed or was cancelled
}

// One fee payment for enrolling a lead in a batch. The amount is copied from the
// batch fee when the order is created, so later fee changes don't rewrite history.
model Payment {
  id               String        @id @default(cuid())
  amountPaise      Int
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  provider         String // "razorpay" or "fake" (local test gateway)
  gatewayOrderId   String        @unique
  // Unique: the checkout callback and the webhook can both report the same payment,
  // and it must only count (and enroll) once.
  gatewayPaymentId String?       @unique
  failureReason    String?
  // Enrolment runs after the payment is confirmed; if it can't (say the email already
  // has an account), the money is still recorded and this says why.
  enrollmentError  String?
  createdAt        DateTime      @default(now())
  paidAt           DateTime?

  leadId      String
  lead        Lead   @relation(fields: [leadId], references: [id], onDelete: Restrict)
  batchId     String
  batch       Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User   @relation("PaymentCreator", fields: [createdById], references: [id])

  @@index([leadId, createdAt])
  @@index([status, paidAt])
}
