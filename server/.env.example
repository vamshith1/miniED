NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://miniedcrm:miniedcrm@localhost:5432/miniedcrm?schema=public
REDIS_URL=redis://localhost:6379
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173

# Local dev seed accounts (npm run db:seed). Change these before deploying.
SEED_ADMIN_EMAIL=admin@miniedcrm.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MENTOR_EMAIL=mentor@miniedcrm.test
SEED_MENTOR_PASSWORD=Mentor@12345

# Email (Phase 6). Without SMTP_URL, emails are saved to server/.outbox/<id>.eml instead of sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=MiniEdCRM <no-reply@miniedcrm.test>
# auto = Redis if reachable, otherwise Postgres (a "bullmq" schema in the same database)
QUEUE_BACKEND=auto
# false when running `npm run worker` as a separate process
RUN_WORKER=true
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAY_MS=30000
# Daily follow-up reminders, cron in the server's timezone
FOLLOW_UP_CRON=0 9 * * *

# Security (step 2 of Phase 8)
# Number of proxies in front of the app (Render, Caddy, nginx: 1) so rate limits see real visitor IPs
TRUST_PROXY=0
# In development, requests from this machine skip rate limits. true = apply them anyway
RATE_LIMIT_LOCAL=false

# Free hosting / production (step 3 of Phase 8; see DEPLOY.md)
# Where uploaded files are kept: database (works anywhere) or disk (a VPS with a volume)
FILE_STORAGE=database
# Password hashing cost, 10-14. Use 10 on slow free CPUs
BCRYPT_ROUNDS=12
# Secret for POST /api/cron/follow-ups (the GitHub Action). Unset = endpoint off. 24+ characters
# CRON_SECRET=
