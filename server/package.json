{
  "name": "miniedcrm-server",
  "version": "1.0.0",
  "description": "MiniEdCRM API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "start:prod": "prisma migrate deploy && node dist/index.js",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:local": "tsx scripts/local-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "test:smoke": "node tests/smoke/1-auth.mjs && node tests/smoke/2-leads.mjs && node tests/smoke/3-batches-attendance.mjs && node tests/smoke/4-quizzes.mjs && node tests/smoke/5-emails.mjs && node tests/smoke/6-dashboard-documents.mjs && node tests/smoke/7-passwords.mjs && node tests/smoke/8-security.mjs && tsx tests/smoke/rank.check.mts"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.4",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^17.11.0-beta.19",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@embedded-postgres/windows-x64@17.11.0-beta.19": true
  }
}
